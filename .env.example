# ============================================================
#  English Tutor Agent — 部署模式配置
#  DEPLOY_MODE=cloud   → 全部走云端 API
#  DEPLOY_MODE=local   → 全部本地推理
# ============================================================
DEPLOY_MODE=cloud

# ────────────────────────────────────────────────────────────
#  通用：API Keys（cloud 模式必需）
# ────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-key-here
DASHSCOPE_API_KEY=sk-your-dashscope-key

# ────────────────────────────────────────────────────────────
#  [cloud 模式] 阿里 MaaS 云端（默认）
# ────────────────────────────────────────────────────────────
LLM_BASE_URL=https://llm-xxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-v4-flash
OMNI_CLOUD_MODEL=qwen3.5-omni-flash-realtime

# ────────────────────────────────────────────────────────────
#  [local 模式] 本地推理（切换到 local 时使用）
# ────────────────────────────────────────────────────────────
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_MODEL=qwen3-vl:8b
# OMNI_CLOUD_MODEL=qwen3-vl:8b
# OMNI_WS_URL=ws://localhost:8765/v1/realtime

# ────────────────────────────────────────────────────────────
#  WebRTC 远程设备模式（realtime_demo --av-source webrtc）
#  音视频由远程浏览器采集/播放（face_preview.html?device=1）
# ────────────────────────────────────────────────────────────
# AV_SOURCE=webrtc
# 唇形同步补偿（毫秒，覆盖浏览器播放缓冲，默认 80）
# VISME_LEAD_MS=80
# 远程浏览器 getUserMedia 需要 HTTPS（localhost 除外）——用 mkcert 签发
# DASHBOARD_TLS_CERT=/path/to/cert.pem
# DASHBOARD_TLS_KEY=/path/to/key.pem
# 可选：/rtc/offer 信令接口的 Bearer 令牌（页面加 ?token=xxx）
# RTC_TOKEN=
# 公网访问（如经 frp 暴露 dashboard）：服务器在 NAT 后，host candidate
# 不可达，必须配 TURN 中转（coturn 搭在公网服务器上）
# RTC_TURN_URL=turn:1.2.3.4:3478
# RTC_TURN_USER=tutor
# RTC_TURN_PASS=your-password
# RTC_STUN_URL=stun:1.2.3.4:3478

# ────────────────────────────────────────────────────────────
#  本地语音管线调参（scripts/local_pipe.py，local 模式）
# ────────────────────────────────────────────────────────────
# STT 后端：gemma = 音频直送本地 LLM 音频输入（实测更准，默认）；
#           whisper = faster-whisper 本地转写（更快）
# STT_BACKEND=gemma
# whisper 兜底/独立使用的模型档：tiny/base/small/medium
# WHISPER_MODEL=small
# RMS 语音检测阈值（浏览器 DSP 已关、噪音底 ~100 时 300 合适）
# VAD_THRESHOLD=300
# 麦克风数字增益（浏览器 AGC 关闭后语音偏小时补偿）
# MIC_GAIN=2.5
# 说完话后的静音判定时长（秒）
# VAD_SILENCE=0.7
# 调试：旁路录制 read_mic() 原始 PCM（16kHz s16 mono）
# RTC_MIC_DUMP=logs/rtc_mic_dump.pcm
